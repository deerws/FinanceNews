# Copie para .env.local e preencha com os valores do painel Supabase
# (Settings > API no seu projeto).
#
# Só a anon key entra aqui — o app Next.js sempre respeita RLS. A
# service_role key (que ignora RLS) fica só no .env do script Python de
# ingestão, na raiz do repositório, nunca aqui.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave pública VAPID (web push) — gerar com `bunx web-push generate-vapid-keys`.
# A privada NUNCA entra aqui, só no .env da raiz (lado Python).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
