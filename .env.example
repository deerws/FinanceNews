# Copie para .env (raiz do repo) e preencha. Usado só pelo `financenews
# ingest` (script Python), que roda no seu computador/cron — nunca é
# exposto ao navegador. A service_role key ignora RLS de propósito, porque
# a ingestão precisa escrever em gestoras/cartas independente de quem "está
# logado" (não há usuário logado num script batch).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — gerado com `bunx web-push generate-vapid-keys` em web/.
# VAPID_PUBLIC_KEY deve ser igual ao NEXT_PUBLIC_VAPID_PUBLIC_KEY do web/.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com
